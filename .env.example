# Alibaba Cloud DashScope (Qwen) — OpenAI-compatible endpoint
# Copy this file to .env and fill in real values. NEVER commit .env.

# Your DashScope API key (Model Studio > API-KEY). Keep secret.
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# OpenAI-compatible base URL. Use the endpoint matching your account region:
#   Workspace-scoped (SG) : https://ws-<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   International         : https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Mainland China        : https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://ws-your-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Workspace ID for workspace-scoped keys (Model Studio > Workspace, format: ws-xxxxxxxx).
# Sent as the X-DashScope-WorkSpace header. Leave blank if your key is not workspace-scoped.
DASHSCOPE_WORKSPACE_ID=

# Qwen model to use for the explanation layer.
QWEN_MODEL=qwen-plus

# ---- Optional runtime settings (defaults shown) ----

# Where the correction log is written. Point it at a mounted volume in a container.
# FEEDBACK_DB_PATH=backend/feedback.db

# Browser origins allowed to call the API directly (comma-separated). The web app goes
# through its own /api proxy, so this only matters for direct use.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trust X-Forwarded-For for per-client rate limits. Only behind a proxy you run.
# TRUST_PROXY_HEADERS=false

# Read by the web app (frontend), not the API: where its /api proxy forwards to, and
# whether to trust X-Forwarded-For (only behind a proxy you run, such as nginx).
# API_URL=http://127.0.0.1:8000
# TRUST_FORWARDED_FOR=false
