# ---- Secrets: never commit ----
.env
.env.*
!.env.example

# Cloud credential exports (Alibaba Cloud downloads these as CSV)
*apiKey*.csv
*api-key*.csv
*accessKey*.csv
*AccessKey*.csv
*credential*.csv

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- Data & models ----
# The raw Synthea bundle is fetched (scripts/fetch_synthea.py) and the intermediate table
# rebuilt. The final labelled dataset and the trained models are committed: the demo, the
# tests and the published numbers all depend on exactly these files.
data/raw/
data/processed/*
!data/processed/claims.parquet

# ---- Runtime artifacts ----
*.db
*.sqlite3
backend/feedback.db

# ---- Local tooling ----
# MCP servers and agent worktrees are per-developer setup, not part of the product.
.mcp.json
.claude/worktrees/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Deck intermediate (regenerate with docs/build_deck.py; deck.pdf/pptx are committed)
docs/deck.html
